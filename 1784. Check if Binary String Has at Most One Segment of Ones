1784. Check if Binary String Has at Most One Segment of Ones
Difficulty - Easy

Solution - O(n)
class Solution {
    public boolean checkOnesSegment(String s) {
        int n = s.length();
        int i = 1;
        while(i < n && s.charAt(i - 1) == s.charAt(i)) i++;
        for(; i < n; i++) if(s.charAt(i) == '1') return false;
        return true;
    }
}
