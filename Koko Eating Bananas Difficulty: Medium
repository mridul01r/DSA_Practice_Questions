Koko Eating Bananas
Difficulty: Medium


Solution - O(n * log(max(arr[i])))
class Solution {
    public boolean helper(int[] arr, int rate, int k) {
        int hr = 0;
        for (int i = 0; i < arr.length; i++) {
            hr += (arr[i] + rate - 1) / rate;
        }
        return hr <= k;
    }

    public int kokoEat(int[] arr, int k) {
        int min = 1;
        int max = 0;

        for (int a : arr) {
            max = Math.max(max, a);
        }

        while (min < max) {
            int mid = min + (max - min) / 2;
            if (helper(arr, mid, k)) {
                max = mid;  
            } else {
                min = mid + 1; 
            }
        }

        return min;
    }
}
