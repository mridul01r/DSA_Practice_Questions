Longest Substring with K Uniques
Difficulty: Medium
Solution - O(n)

class Solution {
    public int longestKSubstr(String s, int k) {
        // code here
        int n = s.length();
        HashMap<Character, Integer> map = new HashMap<>();
        int j = 0;
        int max = -1;
        
        for(int i = 0; i < n; i++){
            char ch = s.charAt(i);
            map.put(ch, map.getOrDefault(ch, 0) + 1);
            while(map.size() > k){
                char c = s.charAt(j);
                map.put(c, map.get(c) - 1);
                if(map.get(c) == 0) map.remove(s.charAt(j));
                j++;
            }
            if(map.size() == k) max = Math.max(i - j + 1, max);
        }
        return max;
    }
}
