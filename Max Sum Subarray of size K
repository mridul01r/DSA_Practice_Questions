Max Sum Subarray of size K
Difficulty: Easy

Solution - O(n)
class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        // Code here
        int max = Integer.MIN_VALUE;
        int i = 0;
        int sum = 0;
        for(int j = 0; j < arr.length; j++){
            if(j - i + 1 > k){
                sum -= arr[i];
                i++;
            }
            sum += arr[j];
            max = Math.max(max, sum);
        }
        return max;
    }
}
