1382. Balance a Binary Search Tree
Difficulty - Medium

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public void inorder(ArrayList<Integer> nodes, TreeNode root){
        if(root == null) return;
        inorder(nodes, root.left);
        nodes.add(root.val);
        inorder(nodes, root.right);
    }

    public TreeNode build(int[] nums, int si, int ei){
        if(si > ei) return null;
        int mid = si + (ei - si)/2;
        TreeNode node = new TreeNode(nums[mid]);
        node.left = build(nums, si, mid - 1);
        node.right = build(nums, mid + 1, ei);
        return node;

    }
    public TreeNode balanceBST(TreeNode root) {
        ArrayList<Integer> nodes = new ArrayList<>();
        inorder(nodes, root);
        int[] nums = new int[nodes.size()];
        int i = 0;
        for(int node : nodes) nums[i++] = node;
        return build(nums, 0, nodes.size() - 1);
    }
}
