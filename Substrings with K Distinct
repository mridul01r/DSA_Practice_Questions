Substrings with K Distinct
Link - https://www.geeksforgeeks.org/problems/count-number-of-substrings4528/1
Difficulty: Medium

Solution - o(n)

class Solution {
    private int countAtMost(String s, int k) {
        int n = s.length();
        int count = 0;
        int left = 0;
        HashMap<Character, Integer> map = new HashMap<>();
        int distinct = 0;
        
        for (int right = 0; right < n; right++) {
            char ch = s.charAt(right);
            map.put(ch, map.getOrDefault(ch, 0) + 1);
            if (map.get(ch) == 1) distinct++;
            
            while (distinct > k && left <= right) {
                char leftCh = s.charAt(left);
                map.put(leftCh, map.get(leftCh) - 1);
                if (map.get(leftCh) == 0) {
                    map.remove(leftCh);
                    distinct--;
                }
                left++;
            }
            count += right - left + 1;
        }
        return count;
    }
    
    public int countSubstr(String s, int k) {
        if (k == 0) return 0;
        return countAtMost(s, k) - countAtMost(s, k - 1);
    }
}
