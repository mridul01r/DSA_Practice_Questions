1653. Minimum Deletions to Make String Balanced
Difficulty - Medium

Solution - O(n)

class Solution {
    public int minimumDeletions(String s) {
        int cnt = 0, ans = 0;
        int n = s.length();
        for(char ch : s.toCharArray()){
            if(ch == 'b') cnt++;
            if(cnt > 0 && ch == 'a'){
                cnt--;
                ans++;
            }
        }
        return ans;
    }
}
