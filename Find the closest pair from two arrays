Find the closest pair from two arrays
Difficulty: Easy

class Solution {
    public static ArrayList<Integer> findClosestPair(int arr1[], int arr2[], int x) {
        
        int n = arr1.length;
        int m = arr2.length;
        
        int i = 0;
        int j = m - 1;
        
        int a1 = 0, a2 = 0;
        int minDiff = Integer.MAX_VALUE;
        
        while(i < n && j >= 0){
            
            int sum = arr1[i] + arr2[j];
            int diff = Math.abs(sum - x);
            if(diff < minDiff || 
               (diff == minDiff && arr1[i] < a1)){
                   
                minDiff = diff;
                a1 = arr1[i];
                a2 = arr2[j];
            }
            
            
            if(sum > x){
                j--;
            } else {
                i++;
            }
        }
        
        ArrayList<Integer> list = new ArrayList<>();
        list.add(a1);
        list.add(a2);
        return list;
    }
}
