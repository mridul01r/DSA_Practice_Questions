3634. Minimum Removals to Balance Array
Difficulty - Medium


Solution - O(n)
class Solution {
    public int minRemoval(int[] nums, int k) {
        int n = nums.length;
        Arrays.sort(nums);
        int ans = 0;
        int j = 0;
        int i = 0;
        while(j < n){
            while(nums[j] > (long)k * nums[i]){
                i++;
            }
            ans = Math.max(ans, (j - i + 1));
            j++;
        }
        return n - ans;

    }
}
