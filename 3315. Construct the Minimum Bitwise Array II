3315. Construct the Minimum Bitwise Array II
Difficulty - Medium

Solution - O(n*32)
class Solution {
    public int[] minBitwiseArray(List<Integer> nums) {
        int n = nums.size();
        int[] ans = new int[n];
        int j = 0;
        for(int num : nums){
            int curr = num;
            if(curr % 2 == 0){
                ans[j] = -1;
            }else{
                for(int i = 0; i < 32; i++){
                    if((curr & (1 << i)) != 0){
                        curr = (curr ^ (1 << i));
                        if((curr | (curr + 1)) == num){
                            ans[j] = curr;
                        }
                        curr = num;
                        }
                    }
                }
            
            j++;
        }
        return ans;
    }
}

class Solution {
    public int[] minBitwiseArray(List<Integer> nums) {
		int n = nums.size();
		int[] ans = new int[n];
		for (int i = 0; i < n; i++) {
			ans[i] = findMinOr(nums.get(i));
		}
		return ans;
	}

	private int findMinOr(int num) {
		if (num == 2)
			return -1;
		int i = 0;
		while ((num & (1 << i)) != 0) {
			i++;
		}
		return num ^ (1 << (i - 1));
	}
}
