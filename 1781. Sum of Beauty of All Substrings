1781. Sum of Beauty of All Substrings
Difficulty - Medium

Solution - O(n * n * 26)
class Solution {
    public int beautySum(String s) {
        int n = s.length();
        int ans = 0;
        for(int i = 0; i < n; i++){
            int[] freq = new int[26];
            freq[s.charAt(i) - 'a']++;
            for(int j = i + 1; j < n; j++){
                char ch = s.charAt(j);
                freq[ch - 'a']++;
                int min = Integer.MAX_VALUE;
                int max = -1;

                for(int f : freq){
                    if(f != 0){
                        min = Math.min(min, f);
                        max = Math.max(max, f);
                    }
                }
                ans += max - min;
            }
        }
        return ans;
    }
}
