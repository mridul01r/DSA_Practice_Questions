Stock span problem
Difficulty - Medium

Solution - O(n)
class Solution {
    public ArrayList<Integer> calculateSpan(int[] arr) {
        // code here
        ArrayList<Integer> ans = new ArrayList<>();
        Stack<Integer> s = new Stack<>();
        int n = arr.length;
        
        ans.add(1);
        s.push(0);
        
        for(int i = 1; i < n; i++){
            
            while(!s.isEmpty() && arr[s.peek()] <= arr[i]){
                s.pop();
            }
            if (s.isEmpty()) {
                ans.add(i + 1);
            } else {
                ans.add(i - s.peek()); 
            }
            s.push(i);

        }
        return ans;
    }
}
