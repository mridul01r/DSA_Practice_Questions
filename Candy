Candy
Link - https://www.geeksforgeeks.org/problems/candy/1
Difficulty - Hard;

Solution - O(n)
class Solution {
    public int minCandy(int arr[]) {
        // code here
        int n = arr.length;
        int[] prefix = new int[n];
        int[] suffix = new int[n];
        Arrays.fill(prefix, 1);
        Arrays.fill(suffix, 1);
        for(int i = 1; i < n; i++){
            if(arr[i] > arr[i - 1]){
                prefix[i] = prefix[i - 1] + 1;
            }else prefix[i] = 1;
        }
        for(int i = n - 2; i >= 0; i--){
            if(arr[i] > arr[i + 1]){
                suffix[i] = suffix[i + 1] + 1;
            }else suffix[i] = 1;
        }
        
        int totalCandies = 0;
        for(int i = 0; i < n; i++) totalCandies += Math.max(prefix[i], suffix[i]);
        return totalCandies;
    }
}
