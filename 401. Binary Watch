401. Binary Watch
Difficulty - Easy

Solution - O(11 * 59)
class Solution {
    public List<String> readBinaryWatch(int turnedOn) {
        List<String> list = new ArrayList<>();
        for(int i = 0; i < 12; i++){
            for(int j = 0; j < 60; j++){
                int x = Integer.bitCount(i);
                int y = Integer.bitCount(j);

                if ((x + y) == turnedOn) list.add(i + ":" + (j < 10 ? "0" + j : j));
            }
        }
        return list;
    }
}
