Maximum Product Subarray
Difficulty: Medium

Solution - O(n)
class Solution {
    int maxProduct(int[] arr) {
        // code here
        int n = arr.length;
        int max = Integer.MIN_VALUE;
        int prod1 = 1;
        for(int a : arr){
            prod1 *= a;
            max = Math.max(prod1, max);
            if(prod1 == 0) prod1 = 1;
        }
        int prod2 = 1;
        for(int i = n - 1; i >= 0; i--){
            prod2 *= arr[i];
            max = Math.max(prod2, max);
            if(prod2 == 0) prod2 = 1;
        }
        
        return max;
    }
}
