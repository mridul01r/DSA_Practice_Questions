Find Kth Rotation
Difficulty: Easy
Solution - o(n)
class Solution {
    public int findKRotation(int arr[]) {
        // Code here
        int indx = 0;
        int min = arr[0];
        for(int i = 1; i < arr.length; i++){
            if(min > arr[i]){
                min = arr[i];
                indx = i;
            }
        }
        return indx;
    }
}
