The Painter's Partition Problem-II
Difficulty: Hard

Solution - O(n * log(sum of all Elements)
class Solution {
    public static boolean canPaint(int[] arr, int maxTime, int k){
        int noOfAllocatedPainter = 1, sum = 0;
        
        for(int num : arr){
            if(sum + num > maxTime){
                noOfAllocatedPainter++;
                sum = 0;
            }
            sum += num;
        }
        return noOfAllocatedPainter <= k;
    }
    public int minTime(int[] arr, int k) {
        // code here
        int l = arr[0], r = 0;
        for(int num : arr){
            if(l < num) l = num;
            r += num;
        }
        
        while(l <= r){
            int mid = l + (r - l)/2;
            
            if(canPaint(arr, mid, k)) r = mid - 1;
            else l = mid + 1;
        }
        return l;
    }
}
