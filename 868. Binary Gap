868. Binary Gap
Difficulty - Easy

Solution - 1
class Solution {
    public int binaryGap(int n) {
        StringBuilder sb = new StringBuilder();
        while(n > 0){
            int rem = n % 2;
            sb.append(rem);
            n >>= 1;
        }
        sb = sb.reverse();
        int len = sb.length(), max = Integer.MIN_VALUE, j = 0, cnt = 0;
        for(int i = 0; i < len; i++){
            if(sb.charAt(i) == '1'){
                max = Math.max(max, i - j);
                j = i;
                cnt++;
            } 
        }
        return cnt == 1 ? 0 : max;
    }
}

Solution - 2
class Solution {
    public int binaryGap(int n) {
        int j = -1, max = 0;
        for(int i = 0; i < 32; i++){
            if((n & (1 << i)) != 0){
                if(j != -1) max = Math.max(max, i - j);
                j = i;
            }
        }
        return max;
    }
}
