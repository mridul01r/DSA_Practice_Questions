Count Inversions
Difficulty - Medium

Solution - O(n * log(n));
class Solution {

    // Merges two subarrays and returns the inversion count
    static int merge(int[] arr, int l, int mid, int r) {
        int n1 = mid - l + 1;
        int n2 = r - mid;
        
        int[] L = new int[n1];
        int[] R = new int[n2];

        for (int i = 0; i < n1; ++i) L[i] = arr[l + i];
        for (int j = 0; j < n2; ++j) R[j] = arr[mid + 1 + j];

        int i = 0, j = 0, k = l;
        int count = 0; 
        
        while (i < n1 && j < n2) {
            if (L[i] <= R[j]) {
                arr[k++] = L[i++];
            } else {
                arr[k++] = R[j++];
                count += (n1 - i);
            }
        }

        while (i < n1) {
            arr[k++] = L[i++];
        }
        while (j < n2) {
            arr[k++] = R[j++];
        }
        
        return count;
    }

    static int sort(int[] arr, int l, int r) {
        int count = 0;
        if (l < r) {
            int mid = l + (r - l) / 2;
            
            count += sort(arr, l, mid);
            count += sort(arr, mid + 1, r);
            count += merge(arr, l, mid, r);
        }
        return count;
    }

    static int inversionCount(int arr[]) {
        int n = arr.length;
        return sort(arr, 0, n - 1);
    }
}
