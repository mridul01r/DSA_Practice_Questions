Number of submatrix have sum X
Difficulty: Hard

Solution - O(n * m * t * t)
class Solution {
    
    public int countSquare(int[][] mat, int x) {
        // code here
        int n = mat.length;
        int m = mat[0].length;
        int cnt = 0;
        int maxSize = Math.min(n,m);
        for(int t = 1; t <= maxSize; t++){
            for(int i = 0; i <= n - t; i++){
                for(int j = 0; j <= m - t; j++){
                    
                    int sum = 0;
                    
                    for(int r = i; r < i + t; r++){
                        for(int c = j; c < j + t; c++){
                            sum += mat[r][c];
                        }
                    }
                    if(sum == x) cnt++;
                }
            }
        }
        return cnt;
        
    }
}
