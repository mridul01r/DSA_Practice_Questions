Last Moment Before All Ants Fall Out
Difficulty: Medium

Solution - O(n1 + m)
class Solution {
    public int getLastMoment(int n, int left[], int right[]) {
        // code here
        int n1 = right.length;
        int m = left.length;
        int leftM = Integer.MIN_VALUE;
        int rightM = Integer.MIN_VALUE;
        
        for(int i = 0; i < n1; i++) rightM = Math.max(n - right[i], rightM);
        
        for(int i = 0; i < m; i++) leftM = Math.max(left[i], leftM);
        
        return Math.max(rightM, leftM);
    }
}
