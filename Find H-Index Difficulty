Find H-Index
Difficulty: Medium

Solution - O(n * log(n))
class Solution {
    public int hIndex(int[] citations) {
        // code here
        Arrays.sort(citations);
        int n = citations.length;
        
        int i = n;
        int j = 1;
        while(i >= 1 && citations[i - 1] >= j){
            j++;
            i--;
        } 
        return j == 1 ? 0 : j - 1;
        
    }
}
