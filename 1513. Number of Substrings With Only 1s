1513. Number of Substrings With Only 1s
Difficulty - Medium

Solution - O(n)
class Solution {
    public int numSub(String s) {
        long ans = 0;
        int n = s.length();
        long cnt = 0;
        long cntO = 0;
        for(int i = 0; i < n; i++){
            if(s.charAt(i) == '1'){
                cnt++;
                cntO++;
            }else{
                if(cnt > 1) ans += ((cnt * (cnt - 1))/2)%1000000007;
                cnt = 0;
            }
        }
        if(cnt > 1) ans += (cnt * (cnt - 1))/2;
        return (int)(ans + cntO) % 1000000007;
    }
}
